#Backend API Base URL
NEXT_PUBLIC_BACKEND_BASE_URL="http://localhost:4001/api/v1"
NEXT_PUBLIC_BACKEND_URL="http://localhost:4001/api/v1"

# App URL (used by better-auth for callbacks and CORS)
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# better-auth secret — generate with: openssl rand -hex 32
# IMPORTANT: Keep this secret and never commit to git
BETTER_AUTH_SECRET="pinezone-secret-change-me-in-production-use-openssl-rand-hex-32"

# better-auth base URL (server-side)
BETTER_AUTH_URL="http://localhost:4000"

# Database (same DB as NestJS API — better-auth manages its own tables)
DB_HOST="localhost"
DB_PORT="5432"
DB_USERNAME="postgres"
DB_PASSWORD="postgres"
DB_DATABASE="oaknpine-app-db"